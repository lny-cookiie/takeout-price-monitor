# 仅监听本机
PORT=4318
DATA_DIR=.runtime
# 可选。未配置时使用 Playwright 安装的 Chromium。
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=C:/path/to/chrome.exe
# MIDSCENE_ADB_PATH=C:/Android/platform-tools/adb.exe
# 在本机 .env 配置企业允许的模型服务。密钥不写入仓库。
# TAKEOUT_MODEL_BASE_URL=https://your-model-gateway.example/v1
# TAKEOUT_MODEL_API_KEY=
# TAKEOUT_MODEL_NAME=qwen3-vl-plus
# TAKEOUT_MODEL_FAMILY=qwen3-vl
# 支持 JSON Schema 的服务可使用 json_schema；其他兼容服务使用 json_object。
# TAKEOUT_MODEL_STRUCTURED_OUTPUT=json_object
# 可选。人民币元 / 百万 token
# TAKEOUT_MODEL_INPUT_RATE=
# TAKEOUT_MODEL_OUTPUT_RATE=
