digraph platform_ue {
  graph [rankdir=TB; newrank=true; bgcolor="white"; pad="0.35"; nodesep="0.38"; ranksep="0.48"; splines="polyline"; fontname="Microsoft YaHei"; fontsize=12; label=<<B>平台 UE：收入减成本</B>>; labelloc=t; fontsize=20; fontcolor="#22313F"];
  node [fontname="Microsoft YaHei"; fontsize=12; shape=box; style="rounded,filled"; color="#7A8A99"; fillcolor="#F5F7FA"; penwidth=1.2; margin="0.22,0.12";];
  edge [fontname="Microsoft YaHei"; fontsize=11; color="#6B7C93"; arrowsize=0.8; penwidth=1.1;];
  subgraph cluster_rev {
    label="平台收入"; fontsize=13; fontcolor="#2F5D8A"; style="rounded,dashed"; color="#A9C0D8"; margin=10;
  commission [label="技术服务费和佣金收入"; fillcolor="#EAF2FB"; color="#3E6D9C"];
  delivery [label="配送收入\n（商家配送服务费 + 顾客配送费）"; fillcolor="#EAF2FB"; color="#3E6D9C"];
  promotion [label="推广和广告收入"; fillcolor="#EAF2FB"; color="#3E6D9C"];
  other [label="其他收入"; fillcolor="#EAF2FB"; color="#3E6D9C"];
    { rank=same; commission; delivery; promotion; other; }
  }
  revenue [label="平台总收入"; fillcolor="#E8EEF7"; color="#2F4B6E"; penwidth=2.0];
  subgraph cluster_cost {
    label="平台成本"; fontsize=13; fontcolor="#8E3B36"; style="rounded,dashed"; color="#D8B3B0"; margin=10;
  rider [label="骑手配送成本"; fillcolor="#FCECEC"; color="#A94A45"];
  subsidy [label="平台补贴（用户和商家）"; fillcolor="#FCECEC"; color="#A94A45"];
  rider_sub [label="骑手补贴"; fillcolor="#FCECEC"; color="#A94A45"];
  variable [label="支付、客服等变动成本"; fillcolor="#FCECEC"; color="#A94A45"];
    { rank=same; rider; subsidy; rider_sub; variable; }
  }
  cost_total [label="平台成本合计"; fillcolor="#F7E3E2"; color="#8E3B36"; penwidth=2.0];
  commission -> revenue;
  delivery -> revenue;
  promotion -> revenue;
  other -> revenue;
  rider -> cost_total;
  subsidy -> cost_total;
  rider_sub -> cost_total;
  variable -> cost_total;
  revenue -> ue [label=" + "];
  cost_total -> ue [label=" - "];
  ue [label="平台单均 UE\n= 平台总收入 - 平台成本合计"; fillcolor="#E8F5E9"; color="#2E7D32"; penwidth=2.4];
  decision [label="平台 UE ≥ 0？"; shape=diamond; fillcolor="#FFF4D6"; color="#A67C00"; penwidth=1.6; margin="0.04,0.02"];
  ue -> decision;
  ok [label="平台侧可持续"; fillcolor="#E8F5E9"; color="#2E7D32"];
  bad [label="平台侧亏损\n调价 / 调补贴 / 调履约"; fillcolor="#FCECEC"; color="#A94A45"];
  decision -> ok [label=" 是 "];
  decision -> bad [label=" 否 "];
}
